{
	"name": "Fugue Development Environment",
	"image": "mcr.microsoft.com/vscode/devcontainers/python:3.11",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.shell.linux": "/bin/bash",
				"python.pythonPath": "/usr/local/bin/python",
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"isort.interpreter": [
					"/usr/local/bin/python"
				],
				"flake8.interpreter": [
					"/usr/local/bin/python"
				],
				"pylint.interpreter": [
					"/usr/local/bin/python"
				]
			},
			"extensions": [
				"ms-python.python",
				"ms-python.isort",
				"ms-python.flake8",
				"ms-python.pylint",
				"ms-python.mypy",
				"GitHub.copilot",
				"njpwerner.autodocstring"
			]
		}
	},
	"forwardPorts": [
		8888
	],
	"postCreateCommand": "make devenv",
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1.1.4": {},
        "ghcr.io/devcontainers/features/node:1.7.1": {},
		"ghcr.io/devcontainers/features/java:1.6.3": {
            "version": "21"
        },
	}
}
